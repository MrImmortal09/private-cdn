# Copy to /etc/private-cdn.env (root:root, mode 600).
CDN_USER=yourname
# Output of: private-cdn hash-password
CDN_PASSWORD_HASH=pbkdf2-sha256:600000:REPLACE:REPLACE
CDN_ROOT=/srv/files
CDN_PUBLIC_URL=https://cdn.axiosiiitl.dev
CDN_ADDR=127.0.0.1:8090
# CDN_STATE_DIR=/var/lib/private-cdn   (default; holds the secret key and share-link index)
